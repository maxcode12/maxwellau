# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# environment — never commit real values
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
!.env.example

# secrets / credentials
*.pem
*.key
*.pfx
*.p12
secrets/
azure-credentials.json

# terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Our envs/*.tfvars hold no secrets (region, SKU, CORS origins) — track them
# for reproducibility. Real secrets (DB passwords) are generated by Terraform
# and stored only in Key Vault, never in these files or in state variables.
!infra/terraform/envs/*.tfvars
# backend.hcl points at the state storage account; generate your own per
# envs/*.backend.hcl.example rather than sharing one.
infra/terraform/envs/*.backend.hcl
!infra/terraform/envs/*.backend.hcl.example
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# prisma
prisma/*.db
prisma/*.db-journal

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# misc
.vercel
*.tsbuildinfo
.turbo/
.cache/

# owner-supplied originals (100MB+) — processed into apps/web/public by
# scripts/prepare-assets.mjs; keep originals out of git. Anchored to repo
# root only — a bare `images/` pattern also matches apps/web/public/images/,
# which holds the *generated* .webp files that must stay tracked.
/images/
.tmp/
