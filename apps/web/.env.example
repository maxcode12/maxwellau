# Maxwell AU — environment variable reference
#
# Names only. NEVER put real values in this file — it is committed.
# Local development: copy to apps/web/.env.local and fill in.
# Deployed environments: values come from Azure Key Vault via Container Apps
# secret references, not from a file.

# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle — never put a secret behind this
# prefix)
# ---------------------------------------------------------------------------

# Canonical absolute origin for this deployment. Drives canonical URLs, Open
# Graph URLs, the sitemap and robots.txt. Only the production value enables
# indexing; any other value emits a "disallow: /" robots policy.
NEXT_PUBLIC_SITE_URL="https://maxwellau.com"

# "off" hides the Phase 1 sample records (releases, videos, events, King's Time
# sessions, testimonies) and leaves the honest empty states in their place.
# Anything else, including unset, shows them.
NEXT_PUBLIC_SAMPLE_CONTENT="on"

# Short commit SHA, injected by CI and reported by /api/health.
NEXT_PUBLIC_BUILD_SHA=

# ---------------------------------------------------------------------------
# Server — PostgreSQL (Phase 2)
# ---------------------------------------------------------------------------

# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server — Azure Blob Storage (Phase 2 / 4)
# ---------------------------------------------------------------------------

# Storage account name only. Access is via Managed Identity in Azure; the
# account key is never set as an application setting.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_MEDIA="media"
AZURE_STORAGE_CONTAINER_PUBLIC="public-media"

# ---------------------------------------------------------------------------
# Server — Observability (Phase 2)
# ---------------------------------------------------------------------------

APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Server — Social publishing (Phases 6–8)
# Values are stored in Key Vault. Listed here so the required configuration is
# discoverable before the integrations are built.
# ---------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=

# Symmetric key used to encrypt stored OAuth refresh tokens at rest.
SOCIAL_TOKEN_ENCRYPTION_KEY=
